  "meta": {
    "name": "extraction_holdout_v1",
    "created": "2026-11-10",
    "labeler": "Claude (claude.ai chat, independent of the extractor; never saw extractor outputs or the dev-set prompt)",
    "human_verified": true,
    "purpose": "Blind held-out test for the Wave 2 AI article reader (Requirement #1: >=18/20). The 20 cases in eval/extraction/cases.json become the DEV set.",
    "composition": "15 distress articles + 5 tricky negatives. No overlap with the dev set. No articles about Bloomfield's past deals or their markets.",
    "copyright": "Labels are facts + URLs only. No article text is stored here. The test must fetch article text at run time (or read it from raw.document).",
    "rules": {
      "literal_only": "A field is filled only if the article text states it. Inferences (state from county, chapter from 'bankruptcy') are listed under accept_soft, never required.",
      "NOT_FOUND": "Exact string NOT FOUND when the text does not state the field.",
      "url_leak": "Text that appears only inside a link URL or slug does NOT count as stated.",
      "negatives": "For N16-N20 only distress_type and expected_stage are scored (must be NOT FOUND). Other fields are informational."
    },
    "scoring": {
      "per_field": "exact match after normalization (case, punctuation, LLC/Inc suffixes, number formatting). accept_soft values count as correct but are reported separately.",
      "hallucination": "Any field where the label is NOT FOUND but the model filled a value. Report count separately; buyer_or_new_operator hallucinations are the worst error class.",
      "article_correct": "An article is correct when all scored fields match. Pass bar: >=18/20 articles AND 0 buyer hallucinations.",
      "report": "Article score, per-field accuracy table, buyer-field accuracy, hallucination count, and the same numbers for Haiku and Sonnet."
    },
    "expected_stage_values": "early | middle | late | sale | NOT FOUND (computed in code, not by the model; used to test Requirement #2)",
    "human_verification_note": "2026-11-10: Aiden spot-checked property + buyer on H01, H02, H04, H09, H12. H15 syndicated link would not open for him; it was verified by Claude's fetch only. Original Business Wire link added as alt_url."
  },
