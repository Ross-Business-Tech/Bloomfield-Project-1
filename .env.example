# Copy to .env and fill in. Never commit .env or paste these values into chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ANTHROPIC_API_KEY=
COURTLISTENER_TOKEN=

# Contact address put in the crawler User-Agent (required by some sites). Never commit the real value.
RESEARCH_CONTACT_EMAIL=
# AI article reader. anthropic (default) | gemini. A new provider is used for evaluations only until it passes
# python -m eval.extraction.compare_models (holdout buyer 12/12, 0 hallucinations).
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=
